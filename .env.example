# Server
PORT=3001

# Scraper tuning
# Delay between chapter requests (ms). Higher = friendlier to the source site.
CHAPTER_DELAY_MS=400
# How many page images to download at once within a chapter.
IMAGE_PARALLELISM=4
# Hard cap on page images scraped per chapter.
MAX_IMAGES_PER_CHAPTER=200

# PDF rendering
# PDF page width in points (390 is phone-friendly; image height follows aspect ratio).
PDF_MAX_PAGE_WIDTH=390
# natural: each image keeps its own height. first: all pages in a chapter use the first image's height.
PDF_CHAPTER_PAGE_SIZE_MODE=natural
# JPEG quality for embedded pages (0-100).
PDF_JPEG_QUALITY=85
# JPEG quality when a source image must be converted for PDF/CBZ output (0-100).
PREPARED_JPEG_QUALITY=95

# Job lifecycle: how long finished jobs (and their PDF/CBZ/temp files) are kept (ms).
JOB_TTL_MS=3600000

# Browser fallback for JS-heavy pages (requires Chromium, see README).
# Set to false to skip Playwright entirely.
JS_RENDER_ENABLED=true
# Timeout for a single rendered page (ms).
JS_RENDER_TIMEOUT_MS=30000
# How many scroll passes to trigger lazy-loaded images.
JS_RENDER_SCROLLS=10

# TLS/HTTP2 impersonation fallback for Cloudflare-blocked pages.
TLS_IMPERSONATION_ENABLED=true
# Extra grace period (ms) before treating a captcha page as blocked.
CAPTCHA_GRACE_MS=8000

# Saved job checkpoints and uploaded cover images.
MANHWA_DOWNLOADER_DATA_DIR=/Users/REPLACE_ME/.manhwa-downloader
# Maximum decoded size of an uploaded cover image (bytes).
COVER_UPLOAD_MAX_BYTES=5242880
# Maximum JSON request body size, allowing base64 cover uploads.
API_JSON_LIMIT=8mb
