# Server
PORT=3000

# Scraper tuning
# Delay between chapter requests (ms). Higher = friendlier to the source site.
CHAPTER_DELAY_MS=400
# How many page images to download at once within a chapter.
IMAGE_PARALLELISM=4
# Hard cap on page images scraped per chapter.
MAX_IMAGES_PER_CHAPTER=200

# PDF rendering
# Max PDF page width in points (image height follows aspect ratio).
PDF_MAX_PAGE_WIDTH=800
# JPEG quality for embedded pages (0-100).
PDF_JPEG_QUALITY=85

# Job lifecycle: how long a finished PDF is kept (ms) before cleanup.
JOB_TTL_MS=3600000
